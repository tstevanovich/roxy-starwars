HOST=127.0.0.1
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/roxy-starwars
# Set to production after npm run build to serve the React app through Express.
NODE_ENV=development
# Authentication is always enabled by server.js. Create your single owner with npm run auth:setup.
# For a named HTTPS tunnel, set its exact origin here (no trailing slash).
# Quick tunnels are registered automatically by npm run remote:start.
# STUDIO_PUBLIC_ORIGIN=https://studio.example.com
# Production chat uses Continue with ChatGPT in its owner-only Connections screen.
# No OPENAI_API_KEY is required or used by studio chat.
# ELEVENLABS_API_KEY=your-elevenlabs-key
# Optional full executable paths if FFmpeg is not on PATH (video frame inspection).
# FFMPEG_PATH=C:/tools/ffmpeg/bin/ffmpeg.exe
# FFPROBE_PATH=C:/tools/ffmpeg/bin/ffprobe.exe

# Local sound mixing (optional overrides; defaults resolve ffmpeg/ffprobe on PATH)
# FFMPEG_PATH=C:/path/to/ffmpeg.exe
# FFPROBE_PATH=C:/path/to/ffprobe.exe
